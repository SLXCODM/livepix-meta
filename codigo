<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Painel Meta LivePix</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;900&display=swap');
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{font-family:'Nunito',sans-serif;background:linear-gradient(180deg,#1e1b4b 0%,#0f0d2e 100%);min-height:100vh;color:#fff;display:flex;flex-direction:column;align-items:center;padding:20px;overflow-x:hidden}
.header{text-align:center;margin-bottom:25px}
.header h1{font-size:22px;font-weight:900;color:#d946ef;text-shadow:0 0 15px rgba(217,70,239,.5);margin-bottom:5px}
.header p{font-size:13px;color:#a78bfa}
.cat-icon{font-size:30px;margin-bottom:5px}
.current-display{background:linear-gradient(145deg,rgba(168,85,247,.2),rgba(217,70,239,.1));border:2px solid #a855f7;border-radius:20px;padding:20px 40px;text-align:center;margin-bottom:25px;box-shadow:0 0 30px rgba(168,85,247,.2);width:100%;max-width:350px}
.current-display .label{font-size:12px;color:#c084fc;text-transform:uppercase;letter-spacing:2px;margin-bottom:5px}
.current-display .value{font-size:42px;font-weight:900;color:#fff;text-shadow:0 0 20px rgba(255,255,255,.3)}
.current-display .meta-info{font-size:13px;color:#fbbf24;margin-top:5px}
.progress-ring{width:120px;height:120px;margin:0 auto 25px;position:relative}
.progress-ring svg{transform:rotate(-90deg)}
.progress-ring circle{fill:none;stroke-width:8}
.progress-ring .bg{stroke:rgba(168,85,247,.2)}
.progress-ring .progress{stroke:url(#gradient);stroke-linecap:round;transition:stroke-dashoffset .8s cubic-bezier(.34,1.56,.64,1);filter:drop-shadow(0 0 5px rgba(217,70,239,.5))}
.progress-text{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:20px;font-weight:900;color:#d946ef}
.quick-buttons{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;width:100%;max-width:350px;margin-bottom:20px}
.quick-btn{background:linear-gradient(145deg,#7c3aed,#a855f7);border:none;border-radius:15px;padding:15px 5px;color:#fff;font-size:16px;font-weight:900;font-family:'Nunito',sans-serif;cursor:pointer;box-shadow:0 4px 15px rgba(124,58,237,.3);transition:all .2s}
.quick-btn:active{transform:scale(.95)}
.quick-btn.gold{background:linear-gradient(145deg,#f59e0b,#fbbf24);box-shadow:0 4px 15px rgba(245,158,11,.3);color:#1e1b4b}
.custom-section{width:100%;max-width:350px;background:rgba(168,85,247,.1);border:1px solid rgba(168,85,247,.3);border-radius:15px;padding:15px;margin-bottom:15px}
.custom-section h3{font-size:13px;color:#c084fc;margin-bottom:10px;text-align:center}
.custom-input-group{display:flex;gap:8px}
.custom-input-group input{flex:1;background:rgba(0,0,0,.3);border:1px solid #a855f7;border-radius:10px;padding:12px 15px;color:#fff;font-size:16px;font-family:'Nunito',sans-serif;outline:none}
.custom-input-group input::placeholder{color:#7c3aed}
.custom-input-group button{background:linear-gradient(145deg,#d946ef,#a855f7);border:none;border-radius:10px;padding:12px 20px;color:#fff;font-size:14px;font-weight:900;font-family:'Nunito',sans-serif;cursor:pointer;white-space:nowrap}
.custom-input-group button:active{transform:scale(.95)}
.action-buttons{display:flex;gap:10px;width:100%;max-width:350px}
.action-btn{flex:1;padding:14px;border:none;border-radius:12px;font-size:14px;font-weight:900;font-family:'Nunito',sans-serif;cursor:pointer;transition:all .2s}
.action-btn.reset{background:linear-gradient(145deg,#ef4444,#dc2626);color:#fff;box-shadow:0 4px 15px rgba(239,68,68,.3)}
.action-btn.undo{background:linear-gradient(145deg,#6366f1,#4f46e5);color:#fff;box-shadow:0 4px 15px rgba(99,102,241,.3)}
.action-btn:active{transform:scale(.95)}
.toast{position:fixed;bottom:30px;left:50%;transform:translateX(-50%) translateY(100px);background:linear-gradient(145deg,#10b981,#059669);color:#fff;padding:12px 25px;border-radius:25px;font-size:14px;font-weight:700;box-shadow:0 5px 20px rgba(16,185,129,.4);opacity:0;transition:all .4s cubic-bezier(.34,1.56,.64,1);z-index:100;white-space:nowrap}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.connection-status{position:fixed;top:10px;right:10px;font-size:11px;color:#34d399;background:rgba(0,0,0,.5);padding:4px 10px;border-radius:10px}
.connection-status.offline{color:#ef4444}
.history-section{width:100%;max-width:350px;margin-top:15px;background:rgba(168,85,247,.05);border-radius:15px;padding:12px;max-height:150px;overflow-y:auto}
.history-section h3{font-size:12px;color:#c084fc;margin-bottom:8px;text-align:center}
.history-item{display:flex;justify-content:space-between;padding:6px 10px;background:rgba(168,85,247,.1);border-radius:8px;margin-bottom:5px;font-size:13px}
.history-item .time{color:#a78bfa;font-size:11px}
.history-item .amount{color:#34d399;font-weight:700}
</style>
</head>
<body>

<svg width="0" height="0">
  <defs>
    <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#a855f7"/>
      <stop offset="100%" style="stop-color:#d946ef"/>
    </linearGradient>
  </defs>
</svg>

<div class="connection-status" id="connStatus">conectando...</div>

<div class="header">
  <div class="cat-icon">🐱</div>
  <h1>Painel da Meta</h1>
  <p>Atualize o valor recebido na live</p>
</div>

<div class="current-display">
  <div class="label">Valor Atual</div>
  <div class="value">R$ <span id="currentDisplay">0,00</span></div>
  <div class="meta-info">Meta: R$ 50,00</div>
</div>

<div class="progress-ring">
  <svg width="120" height="120">
    <circle class="bg" cx="60" cy="60" r="52"/>
    <circle class="progress" cx="60" cy="60" r="52" stroke-dasharray="326.73" stroke-dashoffset="326.73" id="progressCircle"/>
  </svg>
  <div class="progress-text" id="progressText">0%</div>
</div>

<div class="quick-buttons">
  <button class="quick-btn" onclick="addValue(1)">+R$1</button>
  <button class="quick-btn" onclick="addValue(2)">+R$2</button>
  <button class="quick-btn" onclick="addValue(5)">+R$5</button>
  <button class="quick-btn" onclick="addValue(10)">+R$10</button>
  <button class="quick-btn" onclick="addValue(20)">+R$20</button>
  <button class="quick-btn gold" onclick="addValue(50)">+R$50</button>
</div>

<div class="custom-section">
  <h3>💜 Valor Customizado</h3>
  <div class="custom-input-group">
    <input type="number" id="customValue" placeholder="Digite o valor" step="0.01" min="0">
    <button onclick="addCustomValue()">Adicionar</button>
  </div>
</div>

<div class="action-buttons">
  <button class="action-btn reset" onclick="resetValue()">🔄 Zerar</button>
  <button class="action-btn undo" onclick="undoLast()">↩️ Desfazer</button>
</div>

<div class="history-section" id="historySection" style="display:none;">
  <h3>📋 Histórico</h3>
  <div id="historyList"></div>
</div>

<div class="toast" id="toast"></div>

<script>
const META_VALUE=50;
const SUPABASE_URL="https://cugkhfhjvubkpcatxcal.supabase.co";
const SUPABASE_KEY="sb_publishable_omGw32W6HoUkV88hxRHhFA_LHgpYKYc";

let currentValue=0;
let history=[];

const headers={
  "apikey":SUPABASE_KEY,
  "Authorization":"Bearer "+SUPABASE_KEY,
  "Content-Type":"application/json",
  "Prefer":"return=representation"
};

async function init(){
  try{
    let r=await fetch(SUPABASE_URL+"/rest/v1/meta?id=eq.1&select=valor_atual",{method:"GET",headers:headers});
    let d=await r.json();
    if(d&&d.length>0){
      currentValue=parseFloat(d[0].valor_atual)||0;
      updateDisplay();
      document.getElementById("connStatus").textContent="online";
      document.getElementById("connStatus").classList.remove("offline");
    }
  }catch(e){
    document.getElementById("connStatus").textContent="offline";
    document.getElementById("connStatus").classList.add("offline");
    console.error(e);
  }
}

function formatMoney(value){return value.toFixed(2).replace(".",",");}

function updateDisplay(){
  document.getElementById("currentDisplay").textContent=formatMoney(currentValue);
  let percent=Math.min((currentValue/META_VALUE)*100,100);
  document.getElementById("progressText").textContent=Math.floor(percent)+"%";
  let circumference=2*Math.PI*52;
  let offset=circumference-(percent/100)*circumference;
  document.getElementById("progressCircle").style.strokeDashoffset=offset;
}

async function saveToSupabase(){
  try{
    await fetch(SUPABASE_URL+"/rest/v1/meta?id=eq.1",{
      method:"PATCH",
      headers:headers,
      body:JSON.stringify({valor_atual:currentValue,updated_at:new Date().toISOString()})
    });
  }catch(e){console.error("Erro ao salvar:",e);}
}

async function addValue(amount){
  history.push({amount:amount,time:new Date().toLocaleTimeString("pt-BR",{hour:"2-digit",minute:"2-digit"})});
  currentValue+=amount;
  updateDisplay();
  showToast("+ R$ "+formatMoney(amount)+" adicionado! 💜");
  updateHistory();
  await saveToSupabase();
}

async function addCustomValue(){
  let input=document.getElementById("customValue");
  let val=parseFloat(input.value);
  if(val&&val>0){await addValue(val);input.value="";}
}

async function resetValue(){
  if(confirm("Tem certeza que quer zerar a meta?")){
    history=[];
    currentValue=0;
    updateDisplay();
    showToast("Meta zerada! 🔄");
    updateHistory();
    await saveToSupabase();
  }
}

async function undoLast(){
  if(history.length>0){
    let last=history.pop();
    currentValue=Math.max(0,currentValue-last.amount);
    updateDisplay();
    showToast("Última adição desfeita ↩️");
    updateHistory();
    await saveToSupabase();
  }else{showToast("Nada para desfazer");}
}

function updateHistory(){
  let section=document.getElementById("historySection");
  let list=document.getElementById("historyList");
  if(history.length===0){section.style.display="none";return;}
  section.style.display="block";
  list.innerHTML=history.slice(-10).reverse().map(h=>`<div class="history-item"><span class="time">${h.time}</span><span class="amount">+ R$ ${formatMoney(h.amount)}</span></div>`).join("");
}

function showToast(message){
  let toast=document.getElementById("toast");
  toast.textContent=message;
  toast.classList.add("show");
  setTimeout(()=>toast.classList.remove("show"),2500);
}

document.getElementById("customValue").addEventListener("keypress",(e)=>{if(e.key==="Enter")addCustomValue();});

init();
</script>

</body>
</html>
